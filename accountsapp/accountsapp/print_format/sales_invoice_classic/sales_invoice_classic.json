 "html": "<div class=\"invoice\">\n  <h1>Gada Electronics</h1>\n  <p>123, Gokuldham Society, Mumbai</p>\n\n  <hr>\n\n  <p><b>Invoice:</b> {{ doc.name }}</p>\n  <p><b>Date:</b>    {{ doc.invoice_date }}</p>\n  <p><b>Customer:</b> {{ doc.customer }}</p>\n  <p><b>Status:</b>   {{ doc.status }}</p>\n\n  <table>\n    <thead>\n      <tr><th>Item</th><th>Qty</th><th>Rate</th><th>Amount</th></tr>\n    </thead>\n    <tbody>\n    {% for row in doc.items %}\n      <tr>\n        <td>{{ row.item }}</td>\n        <td>{{ row.qty }}</td>\n        <td>{{ row.rate }}</td>\n        <td>{{ row.amount }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n    <tfoot>\n      <tr>\n        <td colspan=\"3\" align=\"right\"><b>Total</b></td>\n        <td><b>{{ doc.total_amount }}</b></td>\n      </tr>\n    </tfoot>\n  </table>\n\n  <p>Thank you for shopping with us!</p>\n</div>\n\n<style>\n  body   { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #222; }\n  h1     { font-size: 20px; margin: 0 0 2px; }\n  table  { width: 100%; border-collapse: collapse; margin-top: 16px; }\n  th, td { border: 1px solid #ccc; padding: 6px 8px; text-align: left; }\n  th     { background: #f0f0f0; }\n  tfoot  { background: #f9f9f9; }\n</style>",
